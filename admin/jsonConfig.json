{
  "i18n": true,
  "type": "panel",
  "items": {
    "hostname": {
      "type": "text",
      "label": "ESS hostname / IP address",
      "help": "e.g. qhome.local or 192.168.1.50",
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 4,
      "xl": 4
    },
    "batCapacity": {
      "type": "number",
      "label": "Battery capacity (kWh)",
      "min": 0.1,
      "step": 0.1,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 4,
      "xl": 4
    },
    "uptIntervall": {
      "type": "number",
      "label": "Polling interval (seconds)",
      "min": 1,
      "max": 2147483,
      "step": 1,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 4,
      "xl": 4
    },
    "extPvHeader": {
      "type": "header",
      "size": 4,
      "newLine": true,
      "text": "Additional PV inverters",
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "extPvHelp": {
      "type": "staticText",
      "newLine": true,
      "text": "Power data points of other PV inverters (e.g. from another adapter). They are added to PvPwTotal and the PV counters. Because the Q.HOME meters at the grid connection point, consumption is then calculated from the energy balance. Values older than 60 s count as 0.",
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "extPvSources": {
      "type": "table",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12,
      "noDelete": false,
      "items": [
        {
          "type": "checkbox",
          "attr": "enabled",
          "title": "Active",
          "width": "10%",
          "default": true
        },
        {
          "type": "text",
          "attr": "name",
          "title": "Name",
          "width": "20%",
          "default": ""
        },
        {
          "type": "objectId",
          "attr": "stateId",
          "title": "Power data point",
          "width": "50%",
          "default": ""
        },
        {
          "type": "select",
          "attr": "unit",
          "title": "Unit",
          "width": "20%",
          "default": "W",
          "options": [
            {
              "label": "W",
              "value": "W"
            },
            {
              "label": "kW",
              "value": "kW"
            }
          ]
        }
      ]
    }
  }
}
